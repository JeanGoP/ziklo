# Copia este archivo como .env junto a Ziklo.Api.dll en el servidor.
# Si un valor necesita espacios al principio o al final, enciérralo entre comillas.
ConnectionStrings__Ziklo=Server=SERVIDOR_SQL;Database=ziklo;User Id=USUARIO;Password=CONTRASENA;Encrypt=True;TrustServerCertificate=False
ZIKLO_JWT_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_32_CARACTERES_O_MAS
Ziklo__DemoMode=false

# Solo para crear el primer administrador con: dotnet Ziklo.Api.dll --seed-admin
# ZIKLO_SEED_EMAIL=admin@empresa.com
# ZIKLO_SEED_PASSWORD=CONTRASENA_SEGURA_DE_12_CARACTERES_O_MAS
# ZIKLO_SEED_COMPANY_NAME=Nombre de la empresa
# ZIKLO_SEED_TAX_ID=NIT_DE_LA_EMPRESA
